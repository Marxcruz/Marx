<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles/style.css" />
</head>
<body>
  <h1>Registro de Usuario</h1>
  <form action="/register" method="POST">
    <div>
      <label for="usuario">Usuario:</label>
      <input type="text" id="usuario" name="usuario" value="<%= oldData.usuario ? oldData.usuario : '' %>" />
      <% if (errors.usuario) { %>
        <p class="error"><%= errors.usuario.msg %></p>
      <% } %>
    </div>
    <div>
      <label for="contraseña">Contraseña:</label>
      <input type="password" id="contraseña" name="contraseña" />
      <% if (errors.contraseña) { %>
        <p class="error"><%= errors.contraseña.msg %></p>
      <% } %>
    </div>
    <div>
      <label for="confirmarContraseña">Confirmar Contraseña:</label>
      <input type="password" id="confirmarContraseña" name="confirmarContraseña" />
      <% if (errors.confirmarContraseña) { %>
        <p class="error"><%= errors.confirmarContraseña.msg %></p>
      <% } %>
    </div>
    <% if (errors.general) { %>
      <p class="error"><%= errors.general.msg %></p>
    <% } %>
    <button type="submit">Registrarse</button>
  </form>
  <p>¿Ya tienes cuenta? <a href="/login">Iniciar sesión</a></p>
</body>
</html>
